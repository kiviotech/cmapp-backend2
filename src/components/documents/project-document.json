{
  "collectionName": "components_documents_project_document",
  "info": {
    "displayName": "Project Document",
    "description": "Stores project document information with metadata"
  },
  "options": {},
  "attributes": {
    "document": {
      "type": "media",
      "multiple": false,
      "required": true
    },
    "document_code": {
      "type": "string",
      "required": true
    },
    "document_type": {
      "type": "enumeration",
      "enum": [
        "drawing",
        "specification",
        "contract",
        "other"
      ]
    },
    "google_drive_link": {
      "type": "string"
    },
    "metadata": {
      "type": "json"
    }
  }
} 