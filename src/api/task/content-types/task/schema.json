{
  "kind": "collectionType",
  "collectionName": "tasks",
  "info": {
    "singularName": "task",
    "pluralName": "tasks",
    "displayName": "task",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "project": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::project.project",
      "inversedBy": "tasks"
    },
    "standard_task": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::standard-task.standard-task",
      "inversedBy": "tasks"
    },
    "submissions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::submission.submission",
      "mappedBy": "task"
    },
    "contractor": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::contractor.contractor",
      "inversedBy": "tasks"
    },
    "documents": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "task_status": {
      "type": "enumeration",
      "enum": [
        "pending",
        "ongoing",
        "ahead",
        "delayed",
        "completed"
      ]
    },
    "due_date": {
      "type": "date"
    },
    "project_team_member": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "tasks"
    },
    "approver": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::project-team.project-team",
      "mappedBy": "tasks"
    },
    "sub_contractor": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::sub-contractor.sub-contractor",
      "inversedBy": "tasks"
    },
    "drawing_code": {
      "type": "string",
      "description": "Code extracted from the linked document (e.g., 'A-106')",
      "required": true,
      "default": "A-106"
    },
    "drawing_url": {
      "type": "string",
      "description": "URL to the drawing document"
    },
    "drawing_codes": {
      "type": "json",
      "description": "Array of codes extracted from documents with page numbers",
      "required": false
    }
  }
}
