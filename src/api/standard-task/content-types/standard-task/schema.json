{
  "kind": "collectionType",
  "collectionName": "standard_tasks",
  "info": {
    "singularName": "standard-task",
    "pluralName": "standard-tasks",
    "displayName": "Standard_task",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Name": {
      "type": "string"
    },
    "Description": {
      "type": "text"
    },
    "subcategory": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::subcategory.subcategory",
      "inversedBy": "standard_tasks"
    },
    "RequiredDocuments": {
      "type": "string"
    },
    "QATeamProcess": {
      "type": "string"
    },
    "QCTeamProcess": {
      "type": "string"
    },
    "consultant": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::consultant.consultant",
      "inversedBy": "standard_tasks"
    },
    "project_team": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::project-team.project-team",
      "inversedBy": "standard_tasks"
    },
    "sub_contractor": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::sub-contractor.sub-contractor",
      "inversedBy": "standard_tasks"
    },
    "tasks": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::task.task",
      "mappedBy": "standard_task"
    },
    "Urls": {
      "type": "string"
    },
    "image": {
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ],
      "type": "media",
      "multiple": true
    },
    "code": {
      "type": "string",
      "required": true,
      "default": "A-100"
    },
    "drawing_code": {
      "type": "string",
      "description": "Code that matches with drawing documents (e.g., 'A-106')"
    }
  }
